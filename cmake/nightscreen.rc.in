// Application resources: exe icon + VERSIONINFO identity.
// Built for native MSVC (RC language) and for the zig cross-build via
// llvm-rc/llvm-cvtres (see CMakeLists). @ICON_PATH@ is substituted by CMake.
1 ICON "@ICON_PATH@"

1 VERSIONINFO
FILEVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,0
PRODUCTVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "mustafadroid"
      VALUE "FileDescription", "night-screen - blue-light filter and eye-break reminders"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "nightscreen"
      VALUE "OriginalFilename", "nightscreen.exe"
      VALUE "ProductName", "night-screen"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
